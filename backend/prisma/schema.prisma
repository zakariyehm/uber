generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  RIDER
  DRIVER
  ADMIN
}

enum Gender {
  MALE
  FEMALE
}

enum OtpPurpose {
  LOGIN
  REGISTER
}

enum DeliveryStatus {
  PENDING
  ACCEPTED
  PICKED_UP
  IN_TRANSIT
  COMPLETED
  CANCELLED
}

enum PaymentHoldStatus {
  NONE
  HELD
  COMMITTED
  RELEASED
}

enum SettlementType {
  NONE
  FULL
  NO_SHOW
  /** Store return: recipient not found — driver gets Delivery State payout from store balance. */
  RETURN
}

enum PaymentPayer {
  SENDER
  RECIPIENT
}

enum SenderKind {
  PERSONAL
  STORE
}

model User {
  id           String   @id @default(uuid())
  role         UserRole
  phone        String   @unique
  email        String?  @unique
  passwordHash String?
  firstName    String?
  lastName     String?
  gender       Gender?
  state        String?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  riderProfile     RiderProfile?
  driverProfile    DriverProfile?
  riderDeliveries  DeliveryRequest[]       @relation("RiderDeliveries")
  driverDeliveries DeliveryRequest[]       @relation("DriverDeliveries")
  sessions         AuthSession[]
  files            UserFile[]
  activeDelivery   DriverActiveDelivery?
  wallet           DriverWallet?
  riderWallet      RiderWallet?
}

model RiderProfile {
  userId      String    @id
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  displayName String?
  /** App self-signup = PERSONAL. Admin-issued store staff = STORE. */
  riderKind   RiderKind @default(PERSONAL)
  storeId     String?
  store       Store?    @relation(fields: [storeId], references: [id], onDelete: SetNull)
  rating      Decimal   @default(5.0) @db.Decimal(3, 2)
  createdAt   DateTime  @default(now())

  @@index([riderKind, storeId])
}

enum RiderKind {
  PERSONAL
  STORE
}

enum VehicleType {
  MOTORCYCLE
  BICYCLE
}

model DriverProfile {
  userId        String      @id
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  displayName   String?
  rating        Decimal     @default(3.0) @db.Decimal(3, 2)
  isOnline      Boolean     @default(false)
  vehicleType   VehicleType @default(MOTORCYCLE)
  licenseNumber String?
  vehicleMake   String?
  vehicleModel  String?
  vehiclePlate  String?
  address       String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([isOnline, vehicleType])
}

model UserFile {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  fileType   String
  storageKey String
  mimeType   String?
  uploadedAt DateTime @default(now())

  @@index([userId])
}

model DeliveryRequest {
  id                     String         @id @default(uuid())
  orderId                String         @unique
  riderUserId            String?
  rider                  User?          @relation("RiderDeliveries", fields: [riderUserId], references: [id])
  pickupLocation         String
  /** Optional GPS for nearby matching (Uber-style). */
  pickupLat              Float?
  pickupLng              Float?
  destinationLocation    String
  destinationLat         Float?
  destinationLng         Float?
  /** Route length used for $0.25/km fare. */
  distanceKm             Decimal?       @db.Decimal(8, 2)
  durationMinutes        Int?
  recipientName          String
  recipientNumber        String
  senderName             String?
  senderPhone            String?
  /** Personal (name+phone) or registered store. */
  senderKind             SenderKind     @default(PERSONAL)
  storeId                String?
  store                  Store?         @relation(fields: [storeId], references: [id], onDelete: SetNull)
  /** Store's own order / BIS code (required when senderKind=STORE). */
  storeOrderCode         String?
  /** Store branch / pickup desk location (required when senderKind=STORE). */
  storeBranchLocation    String?
  /** Who Waafi charges: sender at checkout hold, or recipient at dropoff. */
  payerType              PaymentPayer   @default(SENDER)
  itemType               String
  deliveryMethod         String
  vehicleType            VehicleType    @default(MOTORCYCLE)
  deliveryPrice          Decimal        @db.Decimal(10, 2)
  referenceId            String?
  deliveryTimeLabel      String?
  status                 DeliveryStatus @default(PENDING)
  driverUserId           String?
  driver                 User?          @relation("DriverDeliveries", fields: [driverUserId], references: [id])
  driverName             String?
  paymentRequested       Boolean        @default(false)
  paymentRequestedAt     DateTime?
  driverArrived          Boolean        @default(false)
  driverArrivedAt        DateTime?
  userConfirmedArrival   Boolean        @default(false)
  userConfirmedArrivalAt DateTime?
  userConfirmedPickup    Boolean        @default(false)
  userConfirmedPickupAt  DateTime?
  userConfirmedDelivery  Boolean        @default(false)
  userConfirmedDeliveryAt DateTime?
  offeredToDriverId      String?
  offerExpiresAt         DateTime?
  offerDeclinedIds       String         @default("[]")
  createdAt              DateTime       @default(now())
  acceptedAt             DateTime?
  pickedUpAt             DateTime?
  startedAt              DateTime?
  completedAt            DateTime?
  cancelledAt            DateTime?
  cancelledBy            String?
  cancelReason           String?
  /** Driver could not find recipient — returning package to store (STORE orders). */
  returnRequested        Boolean        @default(false)
  returnRequestedAt      DateTime?
  /** Waafi PreAuthorization lifecycle */
  paymentHoldStatus      PaymentHoldStatus @default(NONE)
  waafiTransactionId     String?
  waafiReferenceId       String?
  paymentHeldAt          DateTime?
  paymentCommittedAt     DateTime?
  paymentReleasedAt      DateTime?
  settlementType         SettlementType    @default(NONE)
  driverEarnings         Decimal?          @db.Decimal(10, 2)
  platformFee            Decimal?          @db.Decimal(10, 2)
  stateShare             Decimal?          @db.Decimal(10, 2)
  riderRefundPending     Decimal?          @db.Decimal(10, 2)
  settledAt              DateTime?
  updatedAt              DateTime          @updatedAt

  activeForDrivers DriverActiveDelivery[]
  storeWalletTxns  StoreWalletTransaction[]

  @@index([status])
  @@index([driverUserId])
  @@index([offeredToDriverId, status])
  @@index([status, vehicleType])
  @@index([storeId])
}

model DriverActiveDelivery {
  driverUserId String           @id
  driver       User             @relation(fields: [driverUserId], references: [id], onDelete: Cascade)
  requestId    String?
  request      DeliveryRequest? @relation(fields: [requestId], references: [id], onDelete: SetNull)
  updatedAt    DateTime         @updatedAt
}

model DriverWallet {
  driverUserId   String   @id
  driver         User     @relation(fields: [driverUserId], references: [id], onDelete: Cascade)
  balance        Decimal  @default(0) @db.Decimal(12, 2)
  tripsCompleted Int      @default(0)
  tripsCancelled Int      @default(0)
  updatedAt      DateTime @updatedAt
}

/** Rider credits from no-show refunds (pending until payouts). */
model RiderWallet {
  riderUserId    String   @id
  rider          User     @relation(fields: [riderUserId], references: [id], onDelete: Cascade)
  pendingBalance Decimal  @default(0) @db.Decimal(12, 2)
  updatedAt      DateTime @updatedAt
}

model AuthSession {
  id               String   @id @default(uuid())
  userId           String
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshTokenHash String
  deviceInfo       String?
  expiresAt        DateTime
  createdAt        DateTime @default(now())

  @@index([userId])
}

model OtpChallenge {
  id         String     @id @default(uuid())
  phone      String
  codeHash   String
  purpose    OtpPurpose
  expiresAt  DateTime
  verifiedAt DateTime?
  attempts   Int        @default(0)
  createdAt  DateTime   @default(now())

  @@index([phone, purpose])
}

enum ServiceCategory {
  MOTO
  DELIVERY_STATE
}

model ServiceMethod {
  id          String          @id @default(uuid())
  category    ServiceCategory
  slug        String          @unique
  name        String
  icon        String          @default("motorbike")
  timeLabel   String
  price       Decimal         @db.Decimal(10, 2)
  vehicleType VehicleType     @default(MOTORCYCLE)
  isActive    Boolean         @default(true)
  sortOrder   Int             @default(0)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([category, isActive, sortOrder])
}

model PlatformSetting {
  id                    String   @id @default("default")
  driverFeeRate         Decimal  @default(0.05) @db.Decimal(5, 4)
  stateDriverPayout     Decimal  @default(0.50) @db.Decimal(10, 2)
  deliveryStateBalance  Decimal  @default(0) @db.Decimal(12, 2)
  updatedAt             DateTime @updatedAt
}

enum StoreCategory {
  GROCERY
  MINI_MART
  PRODUCE
  BUTCHER
  FISH
  BAKERY
  COFFEE
  RESTAURANT
  JUICE
  PHARMACY
  COSMETICS
  ELECTRONICS
  FASHION
  HARDWARE
  WATER_GAS
  FLOWERS
  OTHER
}

model Store {
  id          String        @id @default(uuid())
  name        String
  category    StoreCategory
  phone       String?
  ownerName   String?
  address     String?
  district    String?
  description String?
  /** Available delivery credit. Charged when sender-pay store orders complete. */
  balance     Decimal       @default(0) @db.Decimal(12, 2)
  isActive    Boolean       @default(true)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  deliveries  DeliveryRequest[]
  walletTxns  StoreWalletTransaction[]
  riders      RiderProfile[]

  @@index([category, isActive])
  @@index([name])
}

enum StoreWalletTxnType {
  CREDIT
  DEBIT
  ADJUST
}

enum StoreWalletTxnStatus {
  PENDING
  COMPLETED
  CANCELLED
}

model StoreWalletTransaction {
  id                String               @id @default(uuid())
  storeId           String
  store             Store                @relation(fields: [storeId], references: [id], onDelete: Cascade)
  type              StoreWalletTxnType
  status            StoreWalletTxnStatus @default(COMPLETED)
  amount            Decimal              @db.Decimal(12, 2)
  /** Balance after this txn settles. Unchanged while PENDING. */
  balanceAfter      Decimal              @db.Decimal(12, 2)
  note              String?
  deliveryRequestId String?
  deliveryRequest   DeliveryRequest?     @relation(fields: [deliveryRequestId], references: [id], onDelete: SetNull)
  createdAt         DateTime             @default(now())
  settledAt         DateTime?

  @@index([storeId, createdAt])
  @@index([storeId, status])
  @@index([deliveryRequestId])
}

